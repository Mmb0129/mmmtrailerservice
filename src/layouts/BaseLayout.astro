---
/**
 * The only document skeleton on the site (architect.md §15.3).
 *
 * Header, footer and the mobile action bar are rendered here rather than
 * passed in per page, so no page can ship without them — and the one-tap
 * call/WhatsApp guarantee (O3) holds everywhere by construction.
 */
import SeoHead from '@/components/seo/SeoHead.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileActionBar from '@/components/layout/MobileActionBar.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Prefills the WhatsApp message on this page, e.g. a lane or trailer type. */
  whatsappContext?: string;
}

const { title, description, canonical, ogImage, noindex, whatsappContext } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
    />
    <JsonLd />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <MobileActionBar context={whatsappContext} />
  </body>
</html>
