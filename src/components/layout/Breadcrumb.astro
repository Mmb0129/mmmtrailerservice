---
/**
 * Visible breadcrumb. The BreadcrumbList JSON-LD must mirror this exactly
 * (architect.md §14.4) — so both are generated from the same `items` array.
 */
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...items];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, Astro.site).href,
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      trail.map((c, i) => (
        <li>
          {i === trail.length - 1 ? (
            <span aria-current="page">{c.label}</span>
          ) : (
            <a href={c.href}>{c.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<style>
  .crumbs {
    padding-block: var(--sp-4);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    font-size: var(--fs-small);
  }

  .crumbs li {
    max-width: none;
    display: flex;
    gap: var(--sp-2);
    color: var(--ink-600);
  }

  .crumbs li:not(:last-child)::after {
    content: '/';
    color: var(--rule);
  }

  .crumbs a {
    color: var(--ink-600);
  }

  .crumbs [aria-current='page'] {
    color: var(--ink-900);
    font-weight: 600;
  }
</style>
