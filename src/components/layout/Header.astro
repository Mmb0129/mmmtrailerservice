---
/**
 * Sticky site header (architect.md §9.5).
 *
 * The mobile menu uses <details>/<summary> so it works with zero JavaScript —
 * keyboard operable and screen-reader announced for free, and nothing to go
 * wrong if a script fails to load.
 */
import Logo from './Logo.astro';
import Icon from '@/components/icons/Icons.astro';
import { mainNav } from '@/data/nav';
import { primaryPhone, whatsappUrl } from '@/data/business';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href.replace(/\/$/, '') + '/');
---

<header class="hdr">
  <div class="hdr__inner container">
    <a class="hdr__logo" href="/" aria-label="MMM Trailer Service — home">
      <Logo size={32} tone="light" />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="hdr__cta on-gold" href="/quote/">Get a Quote</a>
    </nav>

    <div class="hdr__compact">
      <a class="hdr__icon" href={primaryPhone.href} aria-label={`Call ${primaryPhone.display}`}>
        <Icon name="phone" size={22} />
      </a>
      <a
        class="hdr__icon"
        href={whatsappUrl()}
        rel="noopener"
        aria-label="Message us on WhatsApp"
      >
        <Icon name="whatsapp" size={22} />
      </a>
      <details class="hdr__menu">
        <summary aria-label="Menu"><Icon name="menu" size={24} /></summary>
        <nav class="hdr__drawer" aria-label="Main, mobile">
          <ul>
            {
              mainNav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a class="hdr__drawer-cta" href="/quote/">Get a Quote</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--navy-800);
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    min-height: 64px;
  }

  .hdr__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    padding-block: var(--sp-2);
  }

  /* ── Desktop nav ─────────────────────────────────────── */
  .hdr__nav {
    display: none;
    align-items: center;
    gap: var(--sp-5);
  }

  .hdr__nav ul {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    list-style: none;
  }

  .hdr__nav li {
    max-width: none;
  }

  .hdr__nav a {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-navy-300);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-base) var(--ease);
  }

  .hdr__nav a:hover,
  .hdr__nav a[aria-current='page'] {
    color: var(--gold-500);
  }

  .hdr__cta {
    padding: 10px 18px;
    background: var(--gold-500);
    color: var(--navy-800) !important;
    border-radius: var(--radius-md);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .hdr__cta:hover {
    background: var(--gold-400);
  }

  /* ── Compact (<900px) ────────────────────────────────── */
  .hdr__compact {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .hdr__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--gold-500);
  }

  .hdr__menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #fff;
    cursor: pointer;
    list-style: none;
  }

  .hdr__menu summary::-webkit-details-marker {
    display: none;
  }

  .hdr__drawer {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--navy-900);
    border-bottom: 3px solid var(--gold-500);
    padding: var(--sp-3) var(--gutter) var(--sp-5);
  }

  .hdr__drawer ul {
    list-style: none;
  }

  .hdr__drawer li {
    max-width: none;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }

  .hdr__drawer a {
    display: block;
    padding: var(--sp-4) 0;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--on-navy-200);
    text-decoration: none;
  }

  .hdr__drawer a[aria-current='page'] {
    color: var(--gold-500);
  }

  .hdr__drawer-cta {
    margin-top: var(--sp-4);
    text-align: center;
    background: var(--gold-500);
    color: var(--navy-800) !important;
    border-radius: var(--radius-md);
  }

  @media (min-width: 900px) {
    .hdr__nav {
      display: flex;
    }

    .hdr__compact {
      display: none;
    }
  }
</style>
