---
import { business, phones, whatsappUrl, addressOneLine } from '@/data/business';

interface Props {
  context?: string;
}
const { context } = Astro.props;
---

<section class="cb">
  <div class="container cb__inner">
    <div>
      <h2>Tell us about the load</h2>
      <p class="cb__note">
        Enquiries welcome any day. We will reply as soon as we can — if it is urgent,
        call.
      </p>
    </div>

    <ul class="cb__list">
      {
        phones.map((p) => (
          <li>
            <a href={p.href} data-track="call_click">
              {p.display}
            </a>
          </li>
        ))
      }
      <li>
        <a href={whatsappUrl(context)} rel="noopener" data-track="whatsapp_click">
          WhatsApp
        </a>
      </li>
      <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
      <li class="cb__addr">{addressOneLine}</li>
    </ul>

    <div class="cb__actions">
      <a class="btn" href="/quote/">Request a quote</a>
    </div>
  </div>
</section>

<style>
  .cb {
    background: var(--navy-800);
    color: var(--on-navy-300);
    padding-block: var(--sp-8);
  }

  .cb h2 {
    color: var(--white);
  }

  .cb__note {
    margin-top: var(--sp-3);
  }

  .cb__inner {
    display: grid;
    gap: var(--sp-6);
    align-items: start;
  }

  .cb__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    font-size: var(--fs-h3);
  }

  .cb__list a {
    color: var(--gold-500);
    font-weight: 700;
    text-decoration: none;
  }

  .cb__list a:hover {
    text-decoration: underline;
  }

  .cb__addr {
    font-size: var(--fs-small);
    color: var(--on-navy-400);
    max-width: 34ch;
  }

  @media (min-width: 900px) {
    .cb__inner {
      grid-template-columns: 1.2fr 1fr auto;
      gap: var(--sp-8);
    }
  }
</style>
