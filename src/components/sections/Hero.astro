---
/**
 * Split hero (architect.md §10.2).
 *
 * NOT full-bleed, deliberately. The best photograph in the library is
 * 1600x900, so a full-bleed desktop hero would have to upscale it. Capping
 * the image column at 720 CSS px keeps it sharp at every breakpoint and
 * happens to look nothing like the overlay-text-on-photo hero that every
 * competitor uses.
 */
import { Picture } from 'astro:assets';
import Figure from '@/components/media/Figure.astro';
import { photo } from '@/data/photos';
import { primaryPhone, whatsappUrl } from '@/data/business';

/**
 * Three real photographs, cross-fading. Motion built from genuine images —
 * nothing generated, nothing retouched (decisions.md D-015).
 *
 * CSS-only: no JavaScript, and the whole animation is switched off under
 * prefers-reduced-motion, where the first frame simply stays put.
 *
 * Slide 1 is the LCP element and loads eagerly at high priority. Slides 2
 * and 3 are not needed for seven seconds, so they load lazily and must not
 * compete with it for bandwidth — that keeps the homepage's initial
 * transfer at ~211 KB rather than ~345 KB.
 */
const slides = [
  {
    img: photo('mmm-trailer-pressure-vessel-highway-01'),
    alt: 'MMM tractor unit hauling a large wrapped cylindrical vessel on a highway',
  },
  {
    img: photo('mmm-trailer-genie-boom-lift'),
    alt: 'Self-propelled boom lift loaded and secured on an MMM semi-low-bed trailer',
  },
  {
    img: photo('mmm-trailer-two-40ft-containers'),
    alt: 'Two 40 ft shipping containers loaded end to end on an MMM trailer',
  },
];

const mobile = photo('mmm-trailer-steel-pipe-roadside');
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__head">
      <h1>40 ft trailer hire across India — high-bed, semi-low-bed and low-bed</h1>
      <p class="hero__lede">
        Containers, machinery, steel, tanks and project cargo — the loads that will not
        fit a lorry. Based in Chennai, loading and delivering anywhere in India.
      </p>

      <div class="hero__cta">
        <a class="btn btn--call" href={primaryPhone.href} data-track="call_click">
          <span class="hero__cta-label">Call&nbsp;us</span><span class="hero__cta-num"
            >{primaryPhone.display}</span
          >
        </a>
        <a class="btn btn--ghost" href={whatsappUrl()} rel="noopener" data-track="whatsapp_click">
          WhatsApp us
        </a>
      </div>
    </div>

    <div class="hero__rest">
      <p class="hero__fallback">
        Can't call right now? <a href="/quote/">Send your load details</a> and we will come
        back to you.
      </p>

      <p class="hero__tertiary">
        <a href="/load-enquiry/">Have loads to move regularly?</a>
        <span aria-hidden="true">·</span>
        <a href="/transport-partners/">Run a trailer? We have loads.</a>
      </p>

      <p class="hero__strip">
        High-bed · Semi-low-bed · Low-bed · Container · ODC &nbsp;|&nbsp; Tamil Nadu ·
        Andhra Pradesh · Karnataka · Telangana · anywhere in India
      </p>

    </div>

    <div class="hero__media">
      <div class="hero__desktop">
        <figure class="hero__show">
          <div class="hero__stage">
            {
              slides.map((s, i) => (
                <Picture
                  class:list={['hero__slide', `hero__slide--${i + 1}`]}
                  src={s.img}
                  alt={s.alt}
                  widths={[620, 1240]}
                  sizes="(min-width: 1100px) 620px, (min-width: 900px) 48vw, 100vw"
                  formats={['webp']}
                  quality={i === 0 ? 72 : 66}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'low'}
                  decoding={i === 0 ? 'sync' : 'async'}
                />
              ))
            }
          </div>
          <figcaption>Our own 40 ft trailers, on real jobs.</figcaption>
        </figure>
      </div>
      <div class="hero__mobile">
        <Figure
          src={mobile}
          alt="Long steel pipes loaded lengthways on an MMM 40 ft trailer"
          caption="Our own 40 ft trailers, on real jobs."
          ratio="4/5"
          sizes="100vw"
          widths={[420, 720]}
          priority
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--navy-800);
    color: var(--on-navy-300);
    padding-block: var(--sp-6) var(--sp-7);
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: var(--sp-7) var(--sp-8);
    }
  }

  .hero__inner {
    display: grid;
    gap: var(--sp-6);
    grid-template-areas:
      'head'
      'media'
      'rest';
  }

  .hero__head {
    grid-area: head;
  }

  .hero__media {
    grid-area: media;
  }

  .hero__rest {
    grid-area: rest;
  }

  .hero h1 {
    color: var(--white);
    font-size: clamp(1.9rem, 1.2rem + 2.2vw, 2.75rem);
    line-height: 1.12;
    max-width: 24ch;
  }

  .hero__lede {
    margin-top: var(--sp-4);
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--on-navy-300);
    max-width: 46ch;
  }

  @media (min-width: 900px) {
    .hero__lede {
      margin-top: var(--sp-5);
      font-size: var(--fs-h3);
    }
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }

  .btn--call {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    padding: var(--sp-3) var(--sp-6);
    line-height: 1.2;
  }

  .hero__cta-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    opacity: 0.75;
  }

  .hero__cta-num {
    font-size: 20px;
    letter-spacing: 0.02em;
  }

  .hero__fallback {
    margin-top: var(--sp-4);
    font-size: var(--fs-small);
    color: var(--on-navy-400);
  }

  .hero__fallback a {
    color: var(--gold-500);
    font-weight: 700;
  }

  .hero__tertiary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
    font-size: var(--fs-small);
  }

  .hero__tertiary a {
    color: var(--gold-500);
  }

  .hero__strip {
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid rgb(255 255 255 / 12%);
    font-size: var(--fs-small);
    color: var(--on-navy-400);
    max-width: none;
  }

  .hero__mobile {
    display: block;
  }

  .hero__desktop {
    display: none;
  }

  @media (min-width: 600px) {
    .hero__mobile {
      display: none;
    }

    .hero__desktop {
      display: block;
    }
  }

  /* ── The cross-fade ────────────────────────────────────────── */
  .hero__show {
    margin: 0;
  }

  .hero__stage {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--navy-900);
  }

  .hero__stage :global(.hero__slide),
  .hero__stage :global(.hero__slide img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__stage :global(.hero__slide) {
    opacity: 0;
    animation: heroFade 21s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .hero__stage :global(.hero__slide--1) {
    animation-delay: 0s;
    opacity: 1;
  }
  .hero__stage :global(.hero__slide--2) {
    animation-delay: 7s;
  }
  .hero__stage :global(.hero__slide--3) {
    animation-delay: 14s;
  }

  @keyframes heroFade {
    0% {
      opacity: 0;
    }
    4%,
    29% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  .hero__show figcaption {
    margin-top: var(--sp-2);
    color: var(--on-navy-400);
  }

  /* Reduced motion: hold the first frame, no cross-fade at all. */
  @media (prefers-reduced-motion: reduce) {
    .hero__stage :global(.hero__slide) {
      animation: none;
      opacity: 0;
    }

    .hero__stage :global(.hero__slide--1) {
      opacity: 1;
    }
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.02fr 1fr;
      grid-template-areas:
        'head  media'
        'rest  media';
      align-content: center;
      column-gap: var(--sp-7);
      row-gap: var(--sp-5);
    }

    .hero__media {
      align-self: center;
    }

    /* Capped so the 1600px sources are never asked to upscale. */
    .hero__media {
      max-width: 620px;
    }
  }

  @media (min-width: 1100px) {
    .hero__inner {
      gap: var(--sp-8);
    }
  }
</style>
