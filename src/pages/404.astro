---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — MMM Trailer Service"
  description="We could not find that page. Here are the places most people are looking for."
  noindex
>
  <section class="section nf">
    <div class="container nf__inner">
      <p class="nf__code">404</p>
      <h1>We could not find that page</h1>
      <p class="nf__lede">It may have moved, or the link may be wrong. Try one of these.</p>
      <ul class="nf__links">
        <li><a href="/">Home</a></li>
        <li><a href="/services/">Trailer services</a></li>
        <li><a href="/fleet/">Our trailers and loads</a></li>
        <li><a href="/routes/">Routes and service areas</a></li>
        <li><a href="/quote/">Request a quote</a></li>
        <li><a href="/transport-partners/">For truck owners</a></li>
        <li><a href="/contact/">Contact us</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__inner {
    max-width: 640px;
  }

  .nf__code {
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 800;
    color: var(--gold-500);
    line-height: 1;
  }

  h1 {
    margin-top: var(--sp-3);
  }

  .nf__lede {
    margin-top: var(--sp-4);
    font-size: var(--fs-h3);
    color: var(--ink-600);
  }

  .nf__links {
    margin-top: var(--sp-6);
    list-style: none;
    display: grid;
    gap: var(--sp-2);
  }

  .nf__links li {
    max-width: none;
    border-bottom: 1px solid var(--rule);
  }

  .nf__links a {
    display: block;
    padding: var(--sp-3) 0;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .nf__links a:hover {
    color: var(--gold-text);
  }
</style>
