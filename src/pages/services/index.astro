---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import Figure from '@/components/media/Figure.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { photo } from '@/data/photos';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Trailer Transport Services — MMM Trailer Service"
  description="40 ft high-bed, semi-low-bed, low-bed and container trailer hire from Chennai, plus machinery and plant movements across India."
>
  <div class="container">
    <Breadcrumb items={[{ label: 'Services', href: '/services/' }]} />
  </div>

  <section class="section">
    <div class="container">
      <h1>What we move, and on what</h1>
      <p class="lede">
        Three trailer configurations, plus container work and machinery movements. If
        you are not sure which you need, tell us the cargo — working that out is part of
        the job.
      </p>

      <ul class="svc">
        {
          services.map((s) => (
            <li class="svc__item">
              <a href={`/services/${s.id}/`}>
                <Figure
                  src={photo(s.data.heroPhoto)}
                  alt={s.data.heroAlt}
                  ratio="3/2"
                  sizes="(min-width: 900px) 380px, 100vw"
                  widths={[400, 760]}
                />
                <h2>{s.data.h1}</h2>
                <p>{s.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .lede {
    margin-block: var(--sp-4) var(--sp-7);
    font-size: var(--fs-h3);
    color: var(--ink-600);
  }

  .svc {
    display: grid;
    gap: var(--sp-6);
    list-style: none;
  }

  .svc__item {
    max-width: none;
  }

  .svc__item a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .svc__item h2 {
    margin-top: var(--sp-4);
    font-size: var(--fs-h3);
  }

  .svc__item a:hover h2 {
    color: var(--gold-text);
  }

  .svc__item p {
    margin-top: var(--sp-2);
    color: var(--ink-600);
  }

  @media (min-width: 600px) {
    .svc {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .svc {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
