---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { primaryPhone } from '@/data/business';

const routes = (await getCollection('routes', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const labelFor = (t: string) =>
  ({
    'high-bed': 'High-bed',
    'semi-low-bed': 'Semi-low-bed',
    'low-bed': 'Low-bed',
    'container-skeletal': 'Container',
    'not-applicable': '',
  })[t] ?? t;
---

<BaseLayout
  title="Routes & Service Areas — Chennai & Across India"
  description="The corridors we work most: Chennai local, Tada and Sri City, Bengaluru, Hyderabad, Thoothukudi, Trichy and Tirunelveli. Enquiries accepted across India."
>
  <div class="container">
    <Breadcrumb items={[{ label: 'Routes', href: '/routes/' }]} />
  </div>

  <section class="section">
    <div class="container">
      <h1>Where we run</h1>
      <p class="lede">
        These are the corridors we work most often. We are based in Chennai and take
        enquiries for movements to and from locations across India — but we would rather
        list the lanes we genuinely know than claim a map full of branches we do not have.
      </p>

      <table class="routes">
        <caption>Our regular corridors</caption>
        <thead>
          <tr>
            <th scope="col">Route</th>
            <th scope="col">Destination state</th>
            <th scope="col">Trailer types</th>
          </tr>
        </thead>
        <tbody>
          {
            routes.map((r) => (
              <tr>
                <th scope="row">
                  <a href={`/routes/${r.id}/`}>{r.data.h1}</a>
                </th>
                <td>
                  {r.data.destinationState}
                  {r.data.interstate && <span class="routes__tag">Interstate</span>}
                </td>
                <td>{r.data.trailerTypes.map(labelFor).filter(Boolean).join(', ')}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <div class="panel">
        <h2>Elsewhere in India</h2>
        <p>
          We accept enquiries for movements to and from other parts of the country. When
          one comes in, we check whether we have a suitable vehicle free; if not, we look
          to the truck owners we work with. Either way we will tell you honestly whether
          we can cover it rather than list a route we cannot service.
        </p>
        <p class="panel__cta">
          <a class="btn" href={primaryPhone.href} data-track="call_click">
            Call&nbsp;{primaryPhone.display}
          </a>
          <a class="btn btn--outline" href="/quote/">Send route details</a>
        </p>
      </div>
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .lede {
    margin-block: var(--sp-4) var(--sp-7);
    font-size: var(--fs-h3);
    color: var(--ink-600);
    max-width: 62ch;
  }

  .routes {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  .routes caption {
    text-align: left;
    font-size: var(--fs-small);
    color: var(--ink-400);
    padding-bottom: var(--sp-3);
  }

  .routes th,
  .routes td {
    padding: var(--sp-4);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }

  .routes thead th {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .routes tbody th a {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 700;
    text-decoration: none;
  }

  .routes tbody th a:hover {
    color: var(--gold-text);
  }

  .routes__tag {
    display: inline-block;
    margin-left: var(--sp-2);
    padding: 2px 8px;
    background: var(--navy-800);
    color: var(--white);
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .panel {
    max-width: 680px;
    margin-top: var(--sp-8);
    padding: var(--sp-6);
    background: var(--white);
    border: 1px solid var(--rule);
    border-left: 4px solid var(--gold-500);
    border-radius: var(--radius-md);
  }

  .panel p {
    margin-top: var(--sp-3);
    color: var(--ink-600);
  }

  .panel__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
</style>
