---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import CargoGrid from '@/components/sections/CargoGrid.astro';
import HowWeWork from '@/components/sections/HowWeWork.astro';
import TrailerTypes from '@/components/sections/TrailerTypes.astro';
import OwnerIntro from '@/components/sections/OwnerIntro.astro';
import EnquirySteps from '@/components/sections/EnquirySteps.astro';
import TruckOwnerBand from '@/components/sections/TruckOwnerBand.astro';
import Faq from '@/components/sections/Faq.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import SectionHeader from '@/components/sections/SectionHeader.astro';
import { homeFaqs } from '@/data/faqs';

const lanes = [
  { label: 'Within Chennai', href: '/routes/chennai-local/' },
  { label: 'Chennai ⇄ Tada and Sri City', href: '/routes/chennai-tada-sri-city/' },
  { label: 'Chennai ⇄ Bengaluru', href: '/routes/chennai-bengaluru/' },
  { label: 'Chennai ⇄ Hyderabad', href: '/routes/chennai-hyderabad/' },
  { label: 'Chennai ⇄ Thoothukudi', href: '/routes/chennai-thoothukudi/' },
  { label: 'Chennai ⇄ Tiruchirappalli', href: '/routes/chennai-trichy/' },
  { label: 'Chennai ⇄ Tirunelveli & Gangaikondan', href: '/routes/chennai-tirunelveli-gangaikondan/' },
];
---

<BaseLayout
  title="MMM Trailer Service — 40 ft Trailer Hire, Chennai"
  description="40 ft container, high-bed, semi-low-bed and low-bed trailers from Chennai. Across Tamil Nadu, Andhra Pradesh, Karnataka, Telangana and all India."
>
  <!-- 1. Hero  2. Capability strip (inside Hero) -->
  <Hero />

  <!-- 3. What we move -->
  <CargoGrid />

  <!-- 4. How we work — the honest replacement for "Own Fleet, No Middlemen" -->
  <HowWeWork />

  <!-- 5. Trailer types -->
  <TrailerTypes />

  <!-- 6. Owner introduction -->
  <OwnerIntro />

  <!-- 7. Where we run -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Where we run"
        heading="Our regular corridors"
        standfirst="These are the corridors we work most often. We run interstate into Andhra Pradesh, Karnataka and Telangana, and take enquiries for movements to and from anywhere in India."
      />
      <ul class="lanes">
        {lanes.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <p class="lanes__more">
        <a class="btn btn--outline" href="/routes/">All routes and service areas</a>
      </p>
    </div>
  </section>

  <!-- 8. How an enquiry works -->
  <EnquirySteps />

  <!-- 9. For truck owners — the capacity side of the business -->
  <TruckOwnerBand />

  <!-- 10. FAQ -->
  <Faq items={homeFaqs} />

  <!-- 11. Contact -->
  <ContactBand />
</BaseLayout>

<style>
  .lanes {
    display: grid;
    gap: var(--sp-3);
    list-style: none;
  }

  .lanes li {
    max-width: none;
    border-bottom: 1px solid var(--rule);
  }

  .lanes a {
    display: block;
    padding: var(--sp-4) 0;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--navy-800);
    text-decoration: none;
  }

  .lanes a:hover {
    color: var(--gold-text);
  }

  .lanes__more {
    margin-top: var(--sp-6);
  }

  @media (min-width: 700px) {
    .lanes {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--sp-7);
    }
  }
</style>
