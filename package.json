{
  "name": "mmmtrailerservice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MMM Trailer Service \u2014 40 ft trailer hire, Chennai",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/gen-netlify-forms.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:seo": "node scripts/check-seo.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "test": "npm run check && npm run build && npm run check:html && npm run check:seo && npm run check:sources && npm run check:content && npm run check:contrast && npm run check:weight && npm run check:a11y",
    "check:weight": "node scripts/check-weight.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^5.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "axe-core": "^4.14.0",
    "html-validate": "^11.16.4",
    "jsdom": "^29.1.1",
    "linkinator": "^8.1.0",
    "typescript": "^5.6.0",
    "wait-on": "^9.5.1"
  }
}
